    "/api/Auth/register-patient": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "DateOfBirth",
                  "Email",
                  "FullName",
                  "Gender",
                  "NationalId",
                  "Password",
                  "UserName"
                ],
                "type": "object",
                "properties": {
                  "FullName": {
                    "type": "string"
                  },
                  "NationalId": {
                    "type": "string"
                  },
                  "DateOfBirth": {
                    "type": "string",
                    "format": "date"
                  },
                  "BloodType": {
                    "$ref": "#/components/schemas/BloodType"
                  },
                  "Address": {
                    "type": "string"
                  },
                  "EmergencyContact": {
                    "type": "string"
                  },
                  "EmergencyPhone": {
                    "type": "string"
                  },
                  "Allergies": {
                    "type": "string"
                  },
                  "ChronicDiseases": {
                    "type": "string"
                  },
                  "ProfilePicture": {
                    "type": "string",
                    "format": "binary"
                  },
                  "Gender": {
                    "$ref": "#/components/schemas/Gender"
                  },
                  "UserName": {
                    "maxLength": 50,
                    "minLength": 0,
                    "type": "string"
                  },
                  "Email": {
                    "type": "string",
                    "format": "email"
                  },
                  "Password": {
                    "maxLength": 100,
                    "minLength": 8,
                    "type": "string"
                  },
                  "PhoneNumber": {
                    "type": "string",
                    "format": "tel"
                  }
                }
              },
              "encoding": {
                "FullName": {
                  "style": "form"
                },
                "NationalId": {
                  "style": "form"
                },
                "DateOfBirth": {
                  "style": "form"
                },
                "BloodType": {
                  "style": "form"
                },
                "Address": {
                  "style": "form"
                },
                "EmergencyContact": {
                  "style": "form"
                },
                "EmergencyPhone": {
                  "style": "form"
                },
                "Allergies": {
                  "style": "form"
                },
                "ChronicDiseases": {
                  "style": "form"
                },
                "ProfilePicture": {
                  "style": "form"
                },
                "Gender": {
                  "style": "form"
                },
                "UserName": {
                  "style": "form"
                },
                "Email": {
                  "style": "form"
                },
                "Password": {
                  "style": "form"
                },
                "PhoneNumber": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
