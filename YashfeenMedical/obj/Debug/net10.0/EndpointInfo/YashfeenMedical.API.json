{
  "openapi": "3.0.4",
  "info": {
    "title": "YashfeenMedical.API",
    "version": "1.0"
  },
  "paths": {
    "/api/Auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/refresh-token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Auth/register-Patient": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "DateOfBirth",
                  "Email",
                  "FullName",
                  "Gender",
                  "NationalId",
                  "Password",
                  "UserName"
                ],
                "type": "object",
                "properties": {
                  "FullName": {
                    "type": "string"
                  },
                  "NationalId": {
                    "type": "string"
                  },
                  "DateOfBirth": {
                    "type": "string",
                    "format": "date"
                  },
                  "BloodType": {
                    "$ref": "#/components/schemas/BloodType"
                  },
                  "Address": {
                    "type": "string"
                  },
                  "EmergencyContact": {
                    "type": "string"
                  },
                  "EmergencyPhone": {
                    "type": "string"
                  },
                  "Allergies": {
                    "type": "string"
                  },
                  "ChronicDiseases": {
                    "type": "string"
                  },
                  "ProfilePicture": {
                    "type": "string",
                    "format": "binary"
                  },
                  "Gender": {
                    "$ref": "#/components/schemas/Gender"
                  },
                  "UserName": {
                    "maxLength": 50,
                    "minLength": 0,
                    "type": "string"
                  },
                  "Email": {
                    "type": "string",
                    "format": "email"
                  },
                  "Password": {
                    "maxLength": 100,
                    "minLength": 8,
                    "type": "string"
                  },
                  "PhoneNumber": {
                    "type": "string",
                    "format": "tel"
                  }
                }
              },
              "encoding": {
                "FullName": {
                  "style": "form"
                },
                "NationalId": {
                  "style": "form"
                },
                "DateOfBirth": {
                  "style": "form"
                },
                "BloodType": {
                  "style": "form"
                },
                "Address": {
                  "style": "form"
                },
                "EmergencyContact": {
                  "style": "form"
                },
                "EmergencyPhone": {
                  "style": "form"
                },
                "Allergies": {
                  "style": "form"
                },
                "ChronicDiseases": {
                  "style": "form"
                },
                "ProfilePicture": {
                  "style": "form"
                },
                "Gender": {
                  "style": "form"
                },
                "UserName": {
                  "style": "form"
                },
                "Email": {
                  "style": "form"
                },
                "Password": {
                  "style": "form"
                },
                "PhoneNumber": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BloodType": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5,
          6,
          7
        ],
        "type": "integer",
        "format": "int32"
      },
      "Gender": {
        "enum": [
          0,
          1
        ],
        "type": "integer",
        "format": "int32"
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    }
  ]
}