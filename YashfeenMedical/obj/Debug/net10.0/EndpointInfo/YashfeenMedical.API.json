          "address": {
            "type": "string",
            "nullable": true
          },
          "emergencyContact": {
            "type": "string",
            "nullable": true
          },
          "emergencyPhone": {
            "type": "string",
            "nullable": true
          },
          "allergies": {
            "type": "string",
            "nullable": true
          },
          "chronicDiseases": {
            "type": "string",
            "nullable": true
          },
          "profilePicture": {
            "type": "string",
            "format": "binary",
            "nullable": true
          },
          "gender": {
            "$ref": "#/components/schemas/Gender"
          }
        },
        "additionalProperties": false
      },
      "PatientUpdateDto": {
        "required": [
          "dateOfBirth",
          "fullName",
          "gender",
          "id",
          "nationalId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "fullName": {
            "minLength": 1,
            "type": "string"
          },
          "nationalId": {
            "minLength": 1,
